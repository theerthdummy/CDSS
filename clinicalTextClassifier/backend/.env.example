# Groq API Keys (4-key round-robin, checked FIRST before Gemini)
# Get your API keys from: https://console.groq.com/keys
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini API Configuration (Fallback after Groq)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# SNOMED CT / Snowstorm terminology server
# Example: http://localhost:8080 or https://snowstorm.example.com
SNOWSTORM_BASE_URL=http://localhost:8080
