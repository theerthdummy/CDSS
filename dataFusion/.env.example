APP_NAME=Agent 4 Clinical Data Fusion API
APP_VERSION=1.0
APP_DESCRIPTION=Clinical Data Fusion service for the multi-agent CDSS.
DEBUG=False
HOST=0.0.0.0
PORT=8004
LOG_LEVEL=INFO
ENV=production
EVIDENCE_PRIORITIES=Latest Medical Evidence,Knowledge Graph,Biomedical RAG

# Groq API Keys (Optional round-robin)
GROQ_API_KEY=your_groq_api_key
GROQ_API_KEY_1=your_groq_api_key
GROQ_API_KEY_2=your_groq_api_key
GROQ_API_KEY_3=your_groq_api_key
GROQ_API_KEY_4=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# LLM Provider & Model Settings
LLM_ENABLED=True
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key
LLM_MODEL_NAME=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct
LLM_TIMEOUT=15.0
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
