# =============================================================================
# Agent 5 Clinical Reasoning System - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env (it is gitignored). This file is safe to commit.

# System Execution Environment & Logging
APP_ENV=development
LOG_LEVEL=INFO

# API Server Host & Port Configuration
API_HOST=0.0.0.0
API_PORT=8005

# Primary Reasoning Provider: Groq GPT-OSS 120B
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=10.0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_TIMEOUT_SECONDS=120.0
PRIMARY_REASONING_PROVIDER=groq
PRIMARY_REASONING_MODEL=mistral:latest

# Fallback Reasoning Provider: Local Ollama Mistral fallback
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_MODEL=gpt-oss-120b
GROQ_TIMEOUT_SECONDS=15.0
FALLBACK_REASONING_PROVIDER=ollama
FALLBACK_REASONING_MODEL=mistral:latest

# Adaptive Evidence Optimizer Configuration
CONFIDENCE_THRESHOLD=0.70
MAX_ADAPTIVE_RETRIES=3

# Upstream Multi-Agent System Base URLs & Timeouts
UPSTREAM_TIMEOUT_SECONDS=30.0
AGENT_2_BASE_URL=http://localhost:8002
AGENT_3_BASE_URL=http://localhost:8003
AGENT_4_BASE_URL=http://localhost:8004
AGENT_5_BASE_URL=http://localhost:8005
